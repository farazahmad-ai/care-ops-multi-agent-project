# CareOps Agent Platform environment variables (placeholders only — never commit .env)

# Application environment (local | staging | production)
APP_ENV=local
# Logging verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
# Service name included in structured logs and traces
SERVICE_NAME=careops-agent-api

# Handed-over CareOps legacy API base URL (no trailing slash)
CAREOPS_LEGACY_URL=http://localhost:8080

# MCP-ONLY secret: never expose to agent-api, LangGraph, or agents (ADR-004, NFR-1)
CAREOPS_SERVICE_TOKEN=replace-with-local-mcp-service-token

# Agent execution safeguards (Task 0.8, NFR-10, AGENTS.md)
REQUEST_TIMEOUT_SECONDS=30
AGENT_RUN_BUDGET_GBP=0.50

