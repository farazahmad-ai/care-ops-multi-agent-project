# CareOps Legacy Company Sandbox Configuration
# Copy this file to .env and replace placeholder values before starting Docker Compose.
APP_NAME=CareOps-Legacy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

# Single bearer token used by legacy integrations (Keycloak/OPA arrives in Phase 1)
SERVICE_TOKEN=replace-with-local-service-token

# Database Settings (container-to-container uses db, host uses localhost:3307)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=careops_legacy
DB_USERNAME=careops_user
DB_PASSWORD=replace-with-local-db-password
DB_ROOT_PASSWORD=replace-with-local-root-password

# Test Database
DB_TEST_DATABASE=careops_legacy_test

# Random Seed for Deterministic Fake Data Generation
SEED_RANDOM_VALUE=12345
